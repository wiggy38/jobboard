DATABASE_URL=postgresql://tumaa:tumaa@localhost:5432/tumaa_dev
REDIS_URL=redis://localhost:6379
NODE_ENV=development
LOG_LEVEL=info

# Extraction sémantique Phase 2 (ai-extractor.ts, ai-normalizer.ts) — clé API
# Anthropic pour Claude Haiku, utilisée par tous les scrapers "jobboard".
ANTHROPIC_API_KEY=

# Rapport quotidien (scheduler.ts — job "daily-report", tous les jours à 22h30)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=m.miguellao@gmail.com
SMTP_PASS=
SMTP_FROM=noreply@tumaa.app
REPORT_EMAIL_TO=m.miguellao@gmail.com

# Scraper "bing-jobs" — DÉSACTIVÉ (retiré de sources/index.ts), non utilisé
# pour le scraping. Grounding with Bing Search via Azure AI Foundry Agent
# (voir src/lib/bing-grounding.ts) — code conservé mais inactif ; variables
# ci-dessous inutiles tant que la source n'est pas réenregistrée.
# Doc : https://learn.microsoft.com/azure/foundry/agents/how-to/tools/bing-tools
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
AZURE_BING_CONNECTION_ID=
AZURE_AI_MODEL_DEPLOYMENT=gpt-4.1-mini
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Scraper "careerjet-bj" — API partenaire officielle Careerjet
# (public.api.careerjet.net), affiliation gratuite. Couvre optioncarriere.bj,
# inaccessible en scraping direct (Cloudflare Turnstile sur toutes les pages).
CAREERJET_AFFID=
