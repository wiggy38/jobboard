server {
    listen 80;
    server_name tumaa.bf www.tumaa.bf;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/javascript application/json;
    gzip_min_length 1024;

    # Landing page déplacée vers apps/home (service tumaa-home, tumaajob.com)
    location = / {
        return 301 https://tumaajob.com;
    }

    # SvelteKit app (admin + B2B + liens tokenisés)
    location /app/ {
        proxy_pass http://${SVELTEKIT_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # App React onboarding (/subscribe, /subscribe/profile, /subscribe/success)
    location = /subscribe {
        return 301 /subscribe/;
    }

    location /subscribe/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /subscribe/index.html;
    }

    # API interne (appelée en relatif par l'app React ci-dessus)
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Liens tokenisés offres (shortcut /offre/ sans passer par /app/)
    location /offre/ {
        proxy_pass http://${SVELTEKIT_UPSTREAM}/offre/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
