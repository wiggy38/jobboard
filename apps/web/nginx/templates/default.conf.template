server {
    listen 80;
    server_name tumaa.bf www.tumaa.bf;

    # Sans resolver + variable, proxy_pass résout SVELTEKIT_UPSTREAM/API_UPSTREAM une
    # seule fois au démarrage de nginx et met l'IP en cache pour toute la durée de vie
    # du conteneur — si le service upstream est redémarré/replanifié ensuite (IP interne
    # Railway changée) sans que nginx le soit aussi, les requêtes restent bloquées sur
    # l'ancienne IP morte jusqu'au timeout (504 constaté en prod le 2026-08-31 sur
    # /offre/). fd12::10 = résolveur DNS interne Railway (voir /etc/resolv.conf du
    # conteneur) ; le passage par une variable $sveltekit_upstream/$api_upstream force
    # nginx à re-résoudre à chaque requête (TTL 10s) au lieu de résoudre une fois pour toutes.
    resolver [fd12::10] valid=10s;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/javascript application/json;
    gzip_min_length 1024;

    # Landing page déplacée vers apps/home (service tumaa-home, www.tumaajob.com — domaine
    # canonique : l'apex tumaajob.com ne peut pas pointer en CNAME vers Railway à cause du MX
    # existant chez le registrar, donc il redirige vers www côté DNS/registrar)
    location = / {
        return 301 https://www.tumaajob.com;
    }

    # SvelteKit app (admin + B2B + liens tokenisés) — regex + capture group pour
    # retirer le préfixe /app/ nous-mêmes : avec un proxy_pass basé sur une variable
    # (nécessaire pour forcer la re-résolution DNS via `resolver` ci-dessus), nginx ne
    # fait plus le remplacement automatique du préfixe de location par l'URI donnée à
    # proxy_pass — un `proxy_pass http://$var/;` transmet l'URI d'origine telle quelle
    # (donc encore préfixée /app/) au lieu de la réécrire, d'où le 404 constaté.
    location ~ ^/app/(.*)$ {
        set $sveltekit_upstream ${SVELTEKIT_UPSTREAM};
        proxy_pass http://$sveltekit_upstream/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # App React onboarding (/subscribe, /subscribe/profile, /subscribe/success)
    location = /subscribe {
        return 301 /subscribe/$is_args$args;
    }

    location /subscribe/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /subscribe/index.html;
    }

    # API interne (appelée en relatif par l'app React ci-dessus) — proxy_pass SANS
    # URI (pas de "/" final) pour ne pas retirer le préfixe /api/ : les routes
    # Fastify sont toutes déclarées avec ce préfixe (ex. /api/subscribe/profile
    # dans apps/api/src/subscribe.routes.ts), donc le retirer fait 404 côté API.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Liens tokenisés offres (shortcut /offre/ sans passer par /app/) — proxy_pass SANS
    # URI (comme /api/ ci-dessus) : la route SvelteKit vit déjà à /offre/[token], donc
    # transmettre l'URI d'origine telle quelle (avec le préfixe /offre/) est correct ;
    # ajouter une URI ici casserait le chemin, cf. commentaire sur /app/ ci-dessus.
    location /offre/ {
        set $sveltekit_upstream ${SVELTEKIT_UPSTREAM};
        proxy_pass http://$sveltekit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fallback vers SvelteKit pour tout le reste servi à la racine du domaine : les
    # pages /offre/[token] et /digest/[token] calculent leur base d'assets relative à
    # la profondeur de la route (voir __sveltekit_mp7k9k.base), donc leurs CSS/JS/images
    # sont demandés en /_app/..., /logo.png, etc. à la racine — sans ce catch-all ils
    # tombent en 404 (page affichée mais sans CSS, constaté en prod le 2026-08-31).
    location / {
        set $sveltekit_upstream ${SVELTEKIT_UPSTREAM};
        proxy_pass http://$sveltekit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
