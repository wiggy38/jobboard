# Serveur
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/tumaa

# Redis / Upstash
REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://:password@your-upstash-url:6380  # Upstash en prod

# Meta Cloud API (WhatsApp Business) — numéro générique de fallback, utilisé
# tant qu'aucun numéro dédié n'est configuré pour un pays ci-dessous (voir
# WHATSAPP_*_<PAYS>). Un seul WEBHOOK_VERIFY_TOKEN suffit quel que soit le
# nombre de numéros : Meta multiplexe tous les numéros d'une même App sur un
# seul webhook, en indiquant `phone_number_id` par message.
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Numéros WhatsApp Business dédiés par pays (optionnel — un pays sans les deux
# variables renseignées retombe sur WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID
# ci-dessus). Voir apps/bot/src/whatsapp/config.ts.
WHATSAPP_PHONE_NUMBER_ID_BF=
WHATSAPP_ACCESS_TOKEN_BF=
WHATSAPP_PHONE_NUMBER_ID_BJ=
WHATSAPP_ACCESS_TOKEN_BJ=
WHATSAPP_PHONE_NUMBER_ID_TG=
WHATSAPP_ACCESS_TOKEN_TG=
WHATSAPP_PHONE_NUMBER_ID_CI=
WHATSAPP_ACCESS_TOKEN_CI=

# Liens tokenisés offres Premium — /offre/{jobId} est servi par apps/backoffice
# (SvelteKit), PAS par apps/web (app React "/subscribe", port 3001). En local,
# apps/backoffice tourne par défaut sur le port 5173 (voir apps/backoffice/vite.config.ts).
JWT_SECRET=change_me_random_secret
TOKEN_SECRET=change_me_random_secret_32chars_minimum
WEB_BASE_URL=http://localhost:5173

# Admin API
ADMIN_SECRET=change_me_random_secret

# Liens d'invitation WhatsApp Channel (wa.me/channel/<code>) — un par pays.
# Meta n'expose aucune API pour auto-abonner un utilisateur à un Channel ;
# seul le clic de l'utilisateur sur ce lien fonctionne (voir services/channels.ts).
CHANNEL_INVITE_LINK_BF=https://wa.me/channel/xxxxxxxxxxxxxxxxxxxx
CHANNEL_INVITE_LINK_BJ=https://wa.me/channel/xxxxxxxxxxxxxxxxxxxx
CHANNEL_INVITE_LINK_TG=https://wa.me/channel/xxxxxxxxxxxxxxxxxxxx
CHANNEL_INVITE_LINK_CI=https://wa.me/channel/xxxxxxxxxxxxxxxxxxxx

# Identifiants WhatsApp des Channels (distincts des liens d'invitation ci-dessus)
# utilisés comme destinataire `to` par le scheduler (src/scheduler.ts) pour poster
# le teaser quotidien de 08:00 — un par pays. Récupérable une fois administrateur
# du Channel dans WhatsApp Manager.
CHANNEL_ID_BF=
CHANNEL_ID_BJ=
CHANNEL_ID_TG=
CHANNEL_ID_CI=
